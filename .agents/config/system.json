{
  "schema_version": 1,
  "database": ".agents/data/agents.db",
  "runtime": {
    "language": "rust",
    "journal_mode": "WAL",
    "synchronous": "NORMAL",
    "busy_timeout_ms": 1000,
    "single_writer_preferred": true
  },
  "model_tiers": {
    "fast": {
      "purpose": "routine execution, lookup, tests, small fixes and reviews"
    },
    "strong": {
      "purpose": "product prioritization, architecture escalation and retrospectives"
    }
  },
  "knowledge_channels": [
    "godot",
    "blender",
    "cpp",
    "python"
  ],
  "hot_path": {
    "allow_etl": false,
    "allow_embeddings": false,
    "allow_bulk_manual_loading": false
  }
}