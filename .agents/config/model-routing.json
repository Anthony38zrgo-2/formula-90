{
  "schema_version": 1,

  "providers": {
    "deepseek": {
      "enabled": true,
      "default_model": "deepseek/deepseek-v4-flash"
    },

    "openai_codex": {
      "enabled": true,
      "luna_model": "gpt-5.6-luna",
      "sol_model": "gpt-5.6-sol"
    }
  },

  "defaults": {
    "cheap_worker": "deepseek/deepseek-v4-flash",
    "codex_worker": "gpt-5.6-luna",
    "strong_model": "gpt-5.6-sol"
  },

  "luna_effort": {
    "lookup": "low",
    "scan": "low",
    "validation": "low",
    "test": "low",
    "implementation": "medium",
    "review": "medium",
    "debug": "high"
  },

  "sol_effort": {
    "default": "medium"
  },

  "limits": {
    "max_attempts_before_strong_escalation": 2,
    "cross_subsystem_threshold": 3
  },

  "codex_profiles": {
    "luna_low": {
      "model": "gpt-5.6-luna",
      "effort": "low"
    },
    "luna_medium": {
      "model": "gpt-5.6-luna",
      "effort": "medium"
    },
    "luna_high": {
      "model": "gpt-5.6-luna",
      "effort": "high"
    },
    "sol_medium": {
      "model": "gpt-5.6-sol",
      "effort": "medium"
    }
  }
}
