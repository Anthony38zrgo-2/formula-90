[configuration]
entry_symbol = "formula90s_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://addons/formula90s/bin/libformula90s.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/formula90s/bin/libformula90s.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/formula90s/bin/libformula90s.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/formula90s/bin/libformula90s.linux.template_release.x86_64.so"

