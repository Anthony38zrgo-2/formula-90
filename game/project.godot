; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FORMULA 90s"
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.7")

[autoload]

InputBindings="*res://scripts/input/input_bindings.gd"
TelemetryManager="*res://scripts/telemetry/telemetry_manager.gd"
VehicleAudioBus="*res://scripts/audio/ensure_vehicle_bus.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[physics]

common/physics_ticks_per_second=120

[audio]

; Drives Godot 4.7's WASAPI shared-mode device period (Engine::get_audio_output_latency()).
; Lower = smaller device buffer = less output latency. Shared mode floors at the device's
; fundamental period (~10 ms), so this is a secondary win vs. the AudioStreamGenerator
; buffer_length set in the native node. No exclusive-mode path exists in Godot 4.7 WASAPI.
audio/output_latency/buffer_size_ms=10

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
