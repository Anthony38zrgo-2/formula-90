{
  "schema_version": 1,
  "id": "formula90_scenic_building_v1",
  "coordinate_system": {
    "units": "metres",
    "up_axis": "+Y",
    "pivot": "ground_center"
  },
  "role": "distant_scenic_environment",
  "collision": {
    "enabled": false,
    "reason": "Buildings are placed at least 65 metres from the track"
  },
  "geometry": {
    "finite_vertices_required": true,
    "degenerate_triangles_allowed": false,
    "consistent_winding_required": true,
    "watertight_visual_required": false,
    "ground_tolerance_m": 0.001
  },
  "placement": {
    "minimum_track_distance_m": 65.0,
    "maximum_track_distance_m": 240.0,
    "scale_minimum": 0.92,
    "scale_maximum": 1.08,
    "deterministic_seed": 1995
  },
  "human_gate": {
    "catalog_must_include_every_asset": true,
    "required_views": ["front", "45_deg", "side", "iso"],
    "track_aerial_required": true,
    "trackside_capture_required": true
  }
}
