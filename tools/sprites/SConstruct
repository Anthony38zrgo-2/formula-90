import os
root = Dir("#").abspath
tool_root = os.path.join(root,"tools","sprites")
validation_root = os.path.join(root,"tools","validation")
env = Environment(ENV=os.environ, CPPPATH=[os.path.join(tool_root,"include"), os.path.join(validation_root,"include"), os.path.join(root,"third_party","stb")])
env.Append(CXXFLAGS=["/std:c++20","/EHsc"] if env["PLATFORM"]=="win32" else ["-std=c++20"])
common=[os.path.join(tool_root,"src","sprite_toolkit.cpp")]
out=os.path.join(root,"build","tools")
env.Program(os.path.join(out,"prepare_sprite"),common+[os.path.join(tool_root,"src","prepare_sprite_main.cpp")])
env.Program(os.path.join(out,"inspect_sprite"),common+[os.path.join(tool_root,"src","inspect_sprite_main.cpp")])
env.Program(os.path.join(out,"build_sprite_sheet"),common+[os.path.join(tool_root,"src","build_sprite_sheet_main.cpp")])
env.Program(os.path.join(out,"sprite_tools_tests"),common+[os.path.join(tool_root,"tests","sprite_tools_tests.cpp")])
wav=[os.path.join(validation_root,"src","wav_analyzer.cpp")]
env.Program(os.path.join(out,"analyze_audio"),wav+[os.path.join(validation_root,"src","analyze_audio_main.cpp")])
env.Program(os.path.join(out,"wav_analyzer_tests"),wav+[os.path.join(validation_root,"tests","wav_analyzer_tests.cpp")])
env.Program(os.path.join(out,"validate_assets"),common+wav+[os.path.join(validation_root,"src","validate_assets_main.cpp")])
