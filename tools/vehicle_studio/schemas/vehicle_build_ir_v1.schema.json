{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vehicle_build_ir_v1.schema.json",
  "title": "VehicleBuildIR v1",
  "type": "object",
  "required": ["schema_version", "document_sha256", "source_sha256", "policy", "parameters", "operations"],
  "properties": {
    "schema_version": {"const": "vehicle-build-ir/v1"},
    "document_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "policy": {
      "type": "object",
      "required": ["topology_changes_allowed", "source_mutation_allowed", "output_scope"],
      "properties": {
        "topology_changes_allowed": {"const": false},
        "source_mutation_allowed": {"const": false},
        "output_scope": {"const": "staging_only"}
      },
      "additionalProperties": false
    },
    "parameters": {"type": "array", "items": {"type": "object"}},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation_id", "order", "kind", "depends_on", "inputs", "postconditions"],
        "properties": {
          "operation_id": {"type": "string"},
          "order": {"type": "integer"},
          "kind": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "object"},
          "postconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
